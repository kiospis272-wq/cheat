        local newCF
        if Config.AIM_Smooth <= 0 or Config.AIM_Smooth >= 30 then
            newCF = goal
        else
            local smoothVal = math.clamp(1 - (Config.AIM_Smooth / 30) * 0.95, 0.05, 0.95)
            newCF = cam.CFrame:Lerp(goal, smoothVal)
        end
        cam.CFrame = newCF
        
        pcall(function()
            local vm = cam:FindFirstChild("ViewModel")
            if vm then
                local cb = vm:FindFirstChild("CameraBone")
                if cb then cb.CFrame = newCF end
                local hrp = vm:FindFirstChild("HRP")
                if hrp then hrp.CFrame = newCF end
            end
        end)
        
        local lookDir = newCF.LookVector
        pcall(function()
            local net = game.ReplicatedStorage:FindFirstChild("network")
            if net then
                local lv = net:FindFirstChild("characterLookvector")
                if lv then
                    lv:FireServer(lookDir)
                    lv:FireServer(aimPos)
                end
                local camSync = net:FindFirstChild("camera")
                if camSync then 
                    camSync:FireServer(newCF.Position, lookDir)
                    camSync:FireServer(newCF)
                end
                local setLook = net:FindFirstChild("setLookvector")
                if setLook then setLook:FireServer(lookDir) end
                
                local hitEvent = net:FindFirstChild("hit")
                if hitEvent then hitEvent:FireServer(aimPos) end
                
                local weaponHit = net:FindFirstChild("weaponhit")
                if weaponHit then weaponHit:FireServer(aimPos) end
                
                local dmg = net:FindFirstChild("Damage")
                if dmg then dmg:FireServer(aimPos, Aimbot.locked) end
                
                local shoot = net:FindFirstChild("shoot")
                if shoot then shoot:FireServer(aimPos) end
            end
        end)
        
        local mousePos = UserInputService:GetMouseLocation()
        Mouse.Hit = CFrame.new(aimPos)
        Mouse.Target = Aimbot.locked
    end
end)

