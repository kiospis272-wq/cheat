local Chams = {}

function Chams.Update()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local char = plr.Character
            local isTeam = Team.isTeammate(char)
            if Config.CHAMS_Enabled and not isTeam then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") and not part:FindFirstChild("ChamsAdorn") then
                        local vis = Cache.visibility[char:FindFirstChild("HumanoidRootPart")] or false
                        local color = vis and Color3.fromRGB(0, 255, 0) or Config.CHAMS_Color
                        local adorn = Instance.new("BoxHandleAdornment")
                        adorn.Name = "ChamsAdorn"
                        adorn.Size = part.Size + Vector3.new(0.05, 0.05, 0.05)
                        adorn.Adornee = part
                        adorn.AlwaysOnTop = true
                        adorn.ZIndex = 10
                        adorn.Color3 = color
                        adorn.Transparency = Config.CHAMS_Transparency
                        adorn.Parent = part
                    elseif part:IsA("BasePart") and part:FindFirstChild("ChamsAdorn") then
                        local vis = Cache.visibility[char:FindFirstChild("HumanoidRootPart")] or false
                        local color = vis and Color3.fromRGB(0, 255, 0) or Config.CHAMS_Color
                        part.ChamsAdorn.Color3 = color
                        part.ChamsAdorn.Transparency = Config.CHAMS_Transparency
                    end
                end
            elseif not Config.CHAMS_Enabled then
                for _, part in ipairs(char:GetDescendants()) do
                    local adorn = part:FindFirstChild("ChamsAdorn")
                    if adorn then pcall(function() adorn:Destroy() end) end
                end
            end
        end
    end
end

