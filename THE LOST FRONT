--[[ ===== CONFIG SAVE/LOAD SYSTEM ===== ]]
local ConfigFile = "fent_config.json"
local function colorToString(color)
    return string.format("%.0f,%.0f,%.0f", color.R * 255, color.G * 255, color.B * 255)
end

local function stringToColor(str)
    local r, g, b = string.match(str, "([^,]+),([^,]+),([^,]+)")
    if r and g and b then
        return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
    end
    return Color3.new(1, 1, 1)
end

local function serializeConfig()
    local serialized = {}
    for key, val in pairs(Config) do
        if type(val) == "boolean" or type(val) == "number" or type(val) == "string" then
            serialized[key] = val
        elseif val and val:IsA("Color3") then
            serialized[key] = "COLOR:" .. colorToString(val)
        end
    end
    
    local json = "{\n"
    local count = 0
    for key, val in pairs(serialized) do
        count = count + 1
        if type(val) == "string" and not val:match("^COLOR:") then
            json = json .. '  "' .. key .. '": "' .. val .. '"'
        elseif type(val) == "number" then
            json = json .. '  "' .. key .. '": ' .. tostring(val)
        elseif type(val) == "boolean" then
            json = json .. '  "' .. key .. '": ' .. (val and "true" or "false")
        elseif type(val) == "string" then
            json = json .. '  "' .. key .. '": "' .. val .. '"'
        end
        if count < 45 then json = json .. ",\n" else json = json .. "\n" end
    end
    json = json .. "}"
    return json
end

local function parseConfig(jsonStr)
    if not jsonStr then return end
    local values = {}
    for key, val in string.gmatch(jsonStr, '"([^"]+)"%s*:%s*([^,}]+)') do
        val = val:gsub("%s+", "")
        if val == "true" then
            values[key] = true
        elseif val == "false" then
            values[key] = false
        elseif tonumber(val) then
            values[key] = tonumber(val)
        elseif val:match("^COLOR:") then
            values[key] = stringToColor(val:sub(7))
        else
            values[key] = val:gsub('"', '')
        end
    end
    return values
end

local function SaveConfig()
    pcall(function()
        local json = serializeConfig()
        writefile(ConfigFile, json)
        print("✅ Config saved!")
    end)
end

local function LoadConfig()
    pcall(function()
        if isfile(ConfigFile) then
            local json = readfile(ConfigFile)
            local values = parseConfig(json)
            if values then
                for key, val in pairs(values) do
                    if Config[key] ~= nil then
                        Config[key] = val
                    end
                end
                print("✅ Config loaded!")
            end
        end
    end)
end

