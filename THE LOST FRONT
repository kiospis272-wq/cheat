function CornerBoxESP.Update()
    if not Config.ESP_CornerBox then
        for plr, obj in pairs(CornerBoxESP.objects) do
            for _, line in ipairs(obj.lines) do line.Visible = false end
        end
        return
    end
    
    local myRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Torso"))
    if not myRoot then return end
    
    local cam = Workspace.CurrentCamera
    if not cam then return end
    
    for plr, obj in pairs(CornerBoxESP.objects) do
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if not char or not hum or hum.Health <= 0 then
            for _, line in ipairs(obj.lines) do line.Visible = false end
        else
            local isTeam = Config.ESP_TeamCheck and Team.isTeammate(char)
            if isTeam then
                for _, line in ipairs(obj.lines) do line.Visible = false end
            else
                local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                local head = char:FindFirstChild("Head")
                
                if root and head then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist <= Config.ESP_MaxDist then
                        local headPos, onHead = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.6, 0))
                        local rootPos, onRoot = cam:WorldToViewportPoint(root.Position)
                        local legPos, onLeg = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 3.5, 0))
                        
                        if onRoot and onHead and onLeg and rootPos.Z > 0 then
                            local rV = Vector2.new(rootPos.X, rootPos.Y)
                            local hV = Vector2.new(headPos.X, headPos.Y)
                            local lV = Vector2.new(legPos.X, legPos.Y)
                            local boxHeight = math.abs(hV.Y - lV.Y)
                            local boxWidth = boxHeight * 0.55
                            local x1 = rV.X - boxWidth / 2
                            local x2 = rV.X + boxWidth / 2
                            local y1 = rV.Y - boxHeight / 2
                            local y2 = rV.Y + boxHeight / 2
                            local len = 6
                            
                            obj.lines[1].From = Vector2.new(x1, y1)
                            obj.lines[1].To = Vector2.new(x1, y1 + len)
                            obj.lines[2].From = Vector2.new(x1, y1)
                            obj.lines[2].To = Vector2.new(x1 + len, y1)
                            obj.lines[3].From = Vector2.new(x2, y1)
                            obj.lines[3].To = Vector2.new(x2, y1 + len)
                            obj.lines[4].From = Vector2.new(x2 - len, y1)
                            obj.lines[4].To = Vector2.new(x2, y1)
                            obj.lines[5].From = Vector2.new(x1, y2)
                            obj.lines[5].To = Vector2.new(x1, y2 - len)
                            obj.lines[6].From = Vector2.new(x1, y2)
                            obj.lines[6].To = Vector2.new(x1 + len, y2)
                            obj.lines[7].From = Vector2.new(x2, y2)
                            obj.lines[7].To = Vector2.new(x2, y2 - len)
                            obj.lines[8].From = Vector2.new(x2 - len, y2)
                            obj.lines[8].To = Vector2.new(x2, y2)
                            
                            for i = 1, 8 do
                                obj.lines[i].Visible = true
                                obj.lines[i].Color = Config.ESP_BoxColor
                                obj.lines[i].Thickness = 2
                            end
                        else
                            for _, line in ipairs(obj.lines) do line.Visible = false end
