    local function setState(newState)
        if newState then
            TweenService:Create(track, TweenInfo.new(0.25), { BackgroundColor3 = accentColor }):Play()
            TweenService:Create(thumb, TweenInfo.new(0.25, Enum.EasingStyle.Exponential), { Position = UDim2.new(0, 26, 0.5, -10) }):Play()
        else
            TweenService:Create(track, TweenInfo.new(0.25), { BackgroundColor3 = Color3.fromRGB(50, 50, 60) }):Play()
            TweenService:Create(thumb, TweenInfo.new(0.25, Enum.EasingStyle.Exponential), { Position = UDim2.new(0, 2, 0.5, -10) }):Play()
        end
        Config[configKey] = newState
        callback(newState)
        SaveConfig()
    end
    
    setState(Config[configKey])
    btn.MouseButton1Click:Connect(function() setState(not Config[configKey]) end)
    return container
end


